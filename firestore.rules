rules_version = '2';
// Quy tắc bảo mật Firestore cho Gia Phả
// Dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function em() { return request.auth.token.email.lower(); }
    function accRef() { return /databases/$(database)/documents/meta/access; }
    function hasAcc() { return exists(accRef()); }
    function acc() { return get(accRef()).data; }
    function isOwner() { return signedIn() && hasAcc() && em() in acc().owners; }
    function isEditor() { return isOwner() || (signedIn() && hasAcc() && em() in acc().editors); }
    function isMember() { return isEditor() || (signedIn() && hasAcc() && em() in acc().members); }

    // Thông tin thành viên: ai cũng xem được, chỉ biên tập viên được sửa
    match /persons/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
    // Liên hệ (SĐT, MXH, địa chỉ): chỉ thành viên được cấp quyền mới xem
    match /contacts/{id} {
      allow read: if isMember();
      allow write: if isEditor();
    }
    // Tin tức: ai cũng đọc, biên tập viên viết
    match /news/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
    // Thông báo của quản trị (GitHub Action đọc và đẩy đến điện thoại)
    match /notices/{id} {
      allow read: if true;
      allow create: if isOwner() && request.resource.data.sent == false;
      allow update, delete: if isOwner();
    }
    // Mã nhận thông báo của từng máy (chỉ quản trị đọc được)
    match /pushTokens/{t} {
      allow create, update: if request.resource.data.token == t
        && request.resource.data.keys().hasOnly(['token', 'platform', 'prefs', 'updatedAt', 'email']);
      allow delete: if true;
      allow read: if isOwner();
    }
    match /meta/clan {
      allow read: if true;
      allow write: if isEditor();
    }
    // Phân quyền: người đầu tiên đăng nhập tự trở thành quản trị
    match /meta/access {
      allow read: if signedIn();
      allow create: if signedIn() && !hasAcc() && request.resource.data.owners == [em()];
      // Biên tập viên được thêm email vào nhóm Thành viên (không đổi quản trị / biên tập)
      allow update: if isOwner() || (isEditor()
        && request.resource.data.owners == resource.data.owners
        && request.resource.data.editors == resource.data.editors
        && request.resource.data.members.hasAll(resource.data.members));
      allow delete: if isOwner();
    }
  }
}
